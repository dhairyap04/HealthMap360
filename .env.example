# Copy to .env for Docker. Native development defaults to SQLite without this file.
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/healthmap360
ENVIRONMENT=development
# Required in production (at least 32 characters). Development uses an ephemeral key if omitted.
# SECRET_KEY=replace-with-a-random-secret
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

# Optional Nominatim-compatible place search provider:
GEOCODING_URL=https://nominatim.openstreetmap.org/search
GEOCODING_USER_AGENT=HealthMap360/0.1 (interactive public health location search)
